        <!-- ===== Panel D: Work distribution ===== -->
        <mxCell id="panelD_hdr" value="Work Distribution Across the Same 42 Real Drivers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="1280" width="1380" height="35" as="geometry" />
        </mxCell>
        <mxCell id="panelD_sub" value="Does the model spread work out, or concentrate it? Same 42-driver pool as above, both arms, across the full data window (not per-cycle)." style="text;html=1;whiteSpace=wrap;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
