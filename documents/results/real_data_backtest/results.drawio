          <mxGeometry x="1120" y="1639" width="280" height="30" as="geometry" />
        </mxCell>

        <mxCell id="panelD_note" value="TRAINED spreads trips MORE evenly across these same 42 drivers than real dispatch did (lower spread, no single driver above 86 trips vs. REAL's single busiest driver at 166) -- an emergent property of the model's own optimization, not a fairness rule anyone added. Still doesn't use all 42 (6 idle) -- this backtest runs with zero exploration (always picks the single best driver, never rotates); more training runs and/or a small amount of exploration in evaluation should spread usage further." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1679" width="1380" height="65" as="geometry" />
        </mxCell>

        <!-- ===== Bottom: honest interpretation banner ===== -->
        <mxCell id="interp_hdr" value="Honest Interpretation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="1765" width="1380" height="35" as="geometry" />
        </mxCell>
        <mxCell id="interp_body" value="100% missed-opportunity recovery is NOT proof of an exceptional model -- real order volume in this window was genuinely light (~13.7 orders/driver across ~5.5 real months), so real fleet-wide capacity likely existed the whole time; not a claim the real dispatcher made 130 provable mistakes (real-world constraints like contract terms and driver preference aren't visible in this data). The cycle-based results above are the more rigorous test: every one of REAL's own 116 real driver-cycles is counted, none excluded, and every metric -- trips, revenue, empty-return miles, unused HOS margin, and elapsed time -- points the same direction. Earlier drafts of this analysis used a different (flawed) method that excluded REAL's worst-performing cycles from its own average and showed REAL winning on cost-per-cycle; that was traced to the exclusion, not a real result, and corrected here." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=middle;fontColor=#5C4A00;spacingLeft=15;spacingRight=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="1805" width="1380" height="95" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="Source: sim/backtest/real_data_replay.py --cycles (cycle-based panels) and --restrict-drivers (missed-opportunity/work-distribution panels), run against the current trained model." style="text;html=1;whiteSpace=wrap;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="60" y="1915" width="1380" height="20" as="geometry" />
        </mxCell>

