<mxfile host="app.diagrams.net">
  <diagram name="Methodology" id="methodology1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Real-Data Backtest Methodology: REAL Dispatch vs. TRAINED Model (Matched Driver Pool)" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- Correction banner -->
        <mxCell id="corr_banner" value="CORRECTED (documents/logs/27 follow-up, direct user correction): an earlier version of this methodology judged TRAINED by a real idle-timeout standard it never applied to REAL, and separately undercounted TRAINED's own relocations. Both fixed -- see the highlighted steps below." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="150" y="65" width="1300" height="40" as="geometry" />
        </mxCell>

        <!-- Source data box -->
        <mxCell id="source" value="Source: ground_truth.historical_orders&#10;(real Excel export, McLeod LoadMaster TMS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="360" height="60" as="geometry" />
        </mxCell>

        <!-- Split into two subsets -->
        <mxCell id="dispatched_src" value="1,929 orders&#10;was_dispatched = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="250" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="undispatched_src" value="141 orders&#10;was_dispatched = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="960" y="250" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_src_disp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" source="source" target="dispatched_src">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_src_undisp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" source="source" target="undispatched_src">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Filter step: dispatched -->
        <mxCell id="dispatched_filter" value="Filter: real origin+dest present&#10;AND matched to a real driver via&#10;trip_number -&gt; historical_legs.driver_id&#10;(historical_legs' own position/timing&#10;columns are 100% null -- confirmed,&#10;not usable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="360" y="360" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e_disp1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="dispatched_src" target="dispatched_filter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="dispatched_usable" value="1,667 usable orders&#10;across 42 real drivers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="510" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e_disp2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="dispatched_filter" target="dispatched_usable">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Filter step: undispatched -->
        <mxCell id="undispatched_filter" value="Filter: real origin+dest present&#10;Real timing: CREATED_TIME joined&#10;from raw Excel Tlorder by bill_number&#10;(actual_pickup is null by definition --&#10;these never got that far)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="940" y="360" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e_undisp1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="undispatched_src" target="undispatched_filter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="undispatched_usable" value="130 usable orders&#10;(48 real yard-shuttle moves,&#10;82 real freight opportunities)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="960" y="505" width="260" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e_undisp2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="undispatched_filter" target="undispatched_usable">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Two arms header -->
        <mxCell id="arms_label" value="Two Arms -- Same Real Orders, Apples-to-Apples Scoring" style="text;html=1;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="300" y="620" width="1000" height="30" as="geometry" />
        </mxCell>

        <!-- REAL arm -->
        <mxCell id="real_arm" value="REAL ARM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="140" y="670" width="380" height="495" as="geometry" />
        </mxCell>

        <mxCell id="real_step1" value="For each of 42 real drivers:&#10;chain their OWN real chronological&#10;orders (sorted by actual_pickup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="165" y="710" width="330" height="55" as="geometry" />
        </mxCell>

        <mxCell id="real_step2" value="Real deadhead = previous real order's&#10;destination -&gt; this order's origin&#10;(real OSRM routing, get_route()) --&#10;priced into the CYCLE's running empty-&#10;miles total, not just the closing leg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="165" y="780" width="330" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e_real1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82B366;" edge="1" parent="1" source="real_step1" target="real_step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="real_step3" value="Score with OUR reward formula:&#10;revenue - deadhead cost ONLY&#10;(no lateness/HOS/breakdown --&#10;not reconstructable for a real&#10;historical driver)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="165" y="850" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_real2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82B366;" edge="1" parent="1" source="real_step2" target="real_step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="real_step3b" value="NEW -- fairness fix: between consecutive&#10;real trips (and to the shared window end),&#10;every 24h check repositioning_outcome() --&#10;the SAME decision TRAINED's IDLE_TIMEOUT&#10;uses -- against REAL's own reconstructed&#10;HOS/position. Reposition toward home once&#10;real urgency justifies it, else nearest hub;&#10;priced as a real empty leg, not a free pass." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="165" y="945" width="330" height="125" as="geometry" />
        </mxCell>
        <mxCell id="e_real2b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82B366;" edge="1" parent="1" source="real_step3" target="real_step3b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="real_step4" value="RESULT: chained into CYCLES (home base -&gt;&#10;home base) -- closed via a real trip landing&#10;at home, a real idle-timeout-driven leg that&#10;reaches home, or an ASSUMED empty return&#10;once the shared window truly runs out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="165" y="1085" width="330" height="75" as="geometry" />
        </mxCell>
        <mxCell id="e_real3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82B366;" edge="1" parent="1" source="real_step3b" target="real_step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- TRAINED arm -->
        <mxCell id="trained_arm" value="TRAINED ARM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="900" y="670" width="420" height="495" as="geometry" />
        </mxCell>

        <mxCell id="trained_step1" value="Merge dispatched (1,667) + undispatched&#10;(130) real orders into ONE chronological&#10;replay timeline (real weight/pallets/&#10;load_type/origin/dest/timing preserved)&#10;-- candidate pool RESTRICTED to the SAME&#10;42 real drivers REAL used, not the full&#10;131-driver fleet (removes any &quot;model picks&#10;different favorite drivers&quot; confound)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="925" y="710" width="370" height="95" as="geometry" />
        </mxCell>

        <mxCell id="trained_step2" value="Replay through OUR OWN internally-&#10;consistent simulated fleet (run_simulation&#10;orders= param) -- fresh start, real HOS,&#10;maintenance, candidate-pool machinery&#10;all run identically to every other sim" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="925" y="818" width="370" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e_trained1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673A6;" edge="1" parent="1" source="trained_step1" target="trained_step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="trained_step3" value="Trained state-value model V(s) drives&#10;every dispatch decision (candidate&#10;scoring: immediate_reward + gamma*V(s'))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="925" y="896" width="370" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e_trained2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673A6;" edge="1" parent="1" source="trained_step2" target="trained_step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="trained_step3b" value="FIXED -- undercounting bug: run_simulation()&#10;now returns a real, structured idle_repositions&#10;log (driver/time/from/to/miles/reached_home).&#10;IDLE_TIMEOUT mutates fleet.drivers[...].location_id&#10;directly, OUTSIDE any trip's own next_location_id --&#10;this log is merged chronologically into the walk&#10;below (32 real relocations/2,260mi were silently&#10;invisible before this fix)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="925" y="971" width="370" height="115" as="geometry" />
        </mxCell>
        <mxCell id="e_trained2b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673A6;" edge="1" parent="1" source="trained_step3" target="trained_step3b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="trained_step4" value="RESULT: SAME 3-way cycle-closing as REAL&#10;(real trip / idle-timeout leg / assumed), plus&#10;missed-opp recovery and work distribution --&#10;HOS-remaining-at-return from the SAME seed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="925" y="1106" width="370" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e_trained3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673A6;" edge="1" parent="1" source="trained_step3b" target="trained_step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- feed lines into arms -->
        <mxCell id="e_feed_real" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#82B366;strokeWidth=2;" edge="1" parent="1" source="dispatched_usable" target="real_step1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="670" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_feed_trained_disp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673A6;strokeWidth=2;" edge="1" parent="1" source="dispatched_usable" target="trained_step1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="630" />
              <mxPoint x="1000" y="630" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_feed_trained_undisp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;strokeColor=#9673A6;strokeWidth=2;" edge="1" parent="1" source="undispatched_usable" target="trained_step1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Comparison bracket -->
        <mxCell id="compare" value="COMPARE, per cycle: trips, revenue, empty-return miles, HOS remaining at return, duration --&#10;plus missed-opportunity recovery and work distribution -- all on the SAME 42-driver pool, BOTH arms now&#10;judged by the identical idle-timeout rule -- reported in results.drawio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="460" y="1200" width="660" height="65" as="geometry" />
        </mxCell>
        <mxCell id="e_compare1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="real_step4" target="compare">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_compare2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="trained_step4" target="compare">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Footer note -->
        <mxCell id="footer" value="Note: this is a REPLAY, not a reconstruction of real historical fleet state -- TRAINED runs through our own internally-consistent simulated fleet fed the real order sequence,&#10;not a recreation of exactly which real drivers were idle/where at each real moment (source data cannot support that -- historical_legs' position/timing columns are 100% null).&#10;A CYCLE = one full loop, home base to home base -- BOTH arms can now close one via a real idle-timeout-driven leg reaching home (documents/logs/27 follow-up), not just REAL waiting for&#10;a paid delivery to happen to land there -- an ASSUMED empty return only fires for whatever gap is left once the shared replay window (sim_end, identical for both arms) truly runs out.&#10;Empty-return-miles is a RUNNING TOTAL across the WHOLE cycle for BOTH arms (fixed same day, documents/logs/27 follow-up) -- every ordinary deadhead-to-pickup leg between consecutive&#10;trips is priced in as it happens, not just whichever leg happened to close the cycle; a 'trip'-closed cycle can still carry real accumulated empty miles from earlier in it.&#10;REAL's HOS-remaining-at-return is reconstructed from the IDENTICAL seeded starting HOS condition TRAINED's own simulated fleet uses (same random seed), then walked through REAL's real timestamps." style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="150" y="1280" width="1300" height="95" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
