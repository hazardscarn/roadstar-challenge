          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="le11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="ratings" target="dashboard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="le12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="quoteRec" target="dashboard">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1250" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="note" value="post_delivery_deadhead_miles = the empty drive-back distance AFTER a delivery, before the next real pickup&#xa;(same concept as sim, tracked identically here) -- the real revenue-loss signal both pipelines are built to minimize." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1000" height="60" as="geometry" />
        </mxCell>

