        <mxCell id="tripCreate" value="Dispatcher assigns one&#xa;-&gt; live.trips created" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1420" y="160" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="geofence" value="Real GPS position updates&#xa;live.process_position_tick() (PL/pgSQL)&#xa;10-min dwell-confirmation buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1420" y="390" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="geofenceEvt" value="live.geofence_events&#xa;live.geofence_dwell_state" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="390" width="240" height="90" as="geometry" />
        </mxCell>

        <mxCell id="detention" value="live.detention_billing&#xa;pg_cron job (compute-detention)&#xa;dwell time beyond the free 2h window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="390" width="280" height="110" as="geometry" />
