<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="1 Training Pipeline" id="train">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1160" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="How the Dispatch Model Is Built: Simulation &#8594; Features &#8594; Reward &#8594; Trained Value Function" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1080" height="34" as="geometry" />
        </mxCell>

        <mxCell id="realData" value="Real Historical Dispatch Data&#xa;2,100+ real orders across 131 real drivers/trucks&#xa;(real carrier TMS export)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="calibration" value="Calibration Layer&#xa;Real order arrival rates &amp; lead-time distributions&#xa;Real dwell times, OSRM-routed lane distances" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="80" width="440" height="110" as="geometry" />
        </mxCell>

        <mxCell id="simEngine" value="Discrete-Event Simulation Engine&#xa;Simulates a fleet operating across real calendar time:&#xa;&#8226; Orders arrive with realistic lead times&#xa;&#8226; Hours-of-Service tracked live against 5 real Canadian legal limits&#xa;&#8226; Every legally-available driver/truck scored as a candidate&#xa;&#8226; Dispatch explores vs. exploits the current value estimate&#xa;&#8226; Truck breakdown &amp; maintenance risk modeled realistically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="920" height="170" as="geometry" />
        </mxCell>

        <mxCell id="nRuns" value="500 Independent Simulated Weeks, run in parallel &#8594; 43,000+ real dispatch decisions generated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="920" height="80" as="geometry" />
        </mxCell>

        <mxCell id="extraction" value="Feature Extraction&#xa;Every decision becomes one&#xa;training row: state &#8594; action&#xa;&#8594; reward &#8594; next-state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="twoModels" value="Two Complementary Trained Models&#xa;Q(state, order, truck) -- scores a SPECIFIC candidate pairing&#xa;V(state) -- scores pure POSITION, via Fitted Value Iteration&#xa;(what is it worth to simply BE here, before knowing the next order?)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="570" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="trainedVF" value="Trained Value Function&#xa;Drives every dispatch decision:&#xa;score = immediate reward&#xa;+ &#947; &#215; V(next state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="570" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="perfPanel" value="Model Performance&#xa;V(s): fit quality (R&#178;) improves from ~0.01 to ~0.27 across iterative refinement (Fitted Value Iteration)&#xa;Q-model: R&#178; = 0.07, beats a naive average-outcome baseline by ~20% on held-out decisions&#xa;Dispatch-quality check: statistically significant improvement in real net reward vs. an untrained baseline (p &lt; 0.01, paired test)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="1080" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.3;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="realData" target="simEngine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.7;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="calibration" target="simEngine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="simEngine" target="nRuns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.17;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nRuns" target="extraction">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="extraction" target="twoModels">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="twoModels" target="trainedVF">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="twoModels" target="perfPanel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="liveNote" value="The trained value function feeds live dispatch scoring identically -- see the Reward Function and Feature Space diagrams for what it's actually optimizing and what it sees." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="840" y="725" width="280" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2 Live Pipeline" id="live">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1700" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title2" value="Live pipeline (Segment 5/7 -- schema built, dashboard/inference planned) — how a real quote becomes a real trip" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="quoteReq" value="Dispatcher submits a quote&#xa;-&gt; live.quote_requests&#xa;(origin, dest, weight, load_type)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="scoreFn" value="dashboard/api/score-quote.py&#xa;(PLANNED -- Vercel Python serverless)&#xa;loads trained V(s) + calibration.assumptions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="80" width="320" height="110" as="geometry" />
        </mxCell>

        <mxCell id="liveState" value="Real-time candidate state&#xa;live.driver_status + truck_maintenance_state&#xa;reference.locations + calibration.lane_routes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="230" width="320" height="110" as="geometry" />
        </mxCell>

        <mxCell id="rewardShared" value="compute_reward() + V(s)&#xa;SAME sim/engine/reward.py module&#xa;used identically in sim and live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="150" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="quoteRec" value="live.quote_recommendations&#xa;ranked top-5 driver/truck options" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="160" width="260" height="90" as="geometry" />
