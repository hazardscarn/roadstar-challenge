        </mxCell>
        <mxCell id="l3g2t" value="Planned -- not built yet" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend3">
          <mxGeometry x="50" y="52" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="l3g3" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="legend3">
          <mxGeometry x="10" y="78" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="l3g3t" value="Shared code (sim = live)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend3">
