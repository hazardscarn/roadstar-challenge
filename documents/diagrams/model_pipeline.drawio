  </diagram>

  <diagram name="3 Reward Function" id="reward">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1480" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="rtitle" value="What the Model Is Actually Optimizing: The Reward Function" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="34" as="geometry" />
        </mxCell>

        <mxCell id="formula" value="score(candidate) = immediate_reward + &#947; &#215; V(landing state)&#xa;&#xa;immediate_reward = order_revenue &#8722; deadhead_cost &#8722; opportunity_cost_penalty &#8722; hos_stranding_risk_penalty &#8722; maintenance_risk_penalty &#8722; expected_lateness_penalty &#8722; cycle_end_stranding_penalty + home_progress_bonus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1400" height="90" as="geometry" />
        </mxCell>

        <mxCell id="rc1" value="order_revenue&#xa;&#xa;Question: what does this trip earn?&#xa;&#xa;Computed: distance-tiered linehaul&#xa;rate &#215; miles (FTL); rate &#215; LTL&#xa;premium &#215; capacity filled (LTL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="rc2" value="deadhead_cost&#xa;&#xa;Question: what does it cost to&#xa;reach this pickup empty?&#xa;&#xa;Computed: empty repositioning&#xa;miles &#215; real operating cost/mile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="390" y="190" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="rc3" value="opportunity_cost_penalty&#xa;(LTL only)&#xa;Question: how much truck&#xa;capacity are we wasting?&#xa;&#xa;Computed: unfilled capacity&#xa;fraction &#215; $ value per lb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="190" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="rc4" value="hos_stranding_risk_penalty&#xa;&#xa;Question: how thin is this&#xa;driver's legal safety margin,&#xa;right now?&#xa;&#xa;Computed: ramps 0&#8594;1 as planned&#xa;duty hours approach the driver's&#xa;remaining legal hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1090" y="190" width="350" height="180" as="geometry" />
        </mxCell>

        <mxCell id="rc5" value="maintenance_risk_penalty&#xa;&#xa;Question: how likely is this&#xa;specific truck to break down?&#xa;&#xa;Computed: expected breakdown&#xa;cost, from real odometer +&#xa;calendar overdue-ness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="rc6" value="expected_lateness_penalty&#xa;&#xa;Question: will this driver&#xa;actually arrive on time?&#xa;&#xa;Computed: real routed ETA vs.&#xa;the promised pickup time;&#xa;penalty grows faster the later&#xa;it runs (convex, not linear)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="390" y="390" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="rc7" value="cycle_end_stranding_penalty&#xa;&#xa;Question: could this trip leave&#xa;the driver stranded once their&#xa;weekly/bi-weekly legal hours&#xa;run out?&#xa;&#xa;Computed: fires only when the&#xa;LANDING state is both close to&#xa;the legal cycle limit AND still&#xa;far from home base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="390" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="rc8" value="home_progress_bonus&#xa;&#xa;Question: does this trip help&#xa;work the driver back toward&#xa;base, or away from it?&#xa;&#xa;Computed: rewards PARTIAL,&#xa;PROPORTIONAL progress toward&#xa;home -- weighted by how&#xa;urgently it's actually needed,&#xa;not a flat bonus every time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1090" y="390" width="350" height="180" as="geometry" />
        </mxCell>

        <mxCell id="rlegend" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rl1" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="rlegend">
