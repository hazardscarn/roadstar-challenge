        </mxCell>
        <mxCell id="l3g1" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="legend3">
          <mxGeometry x="10" y="30" width="30" height="16" as="geometry" />
        </mxCell>
