  <diagram name="4 Feature Space" id="features">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1480" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ftitle" value="What the Model Actually Sees: State &amp; Feature Space" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="34" as="geometry" />
        </mxCell>

        <mxCell id="leftPanelHdr" value="V(s) -- Position-Only State&#xa;&quot;How good is it to simply BE here, right now -- independent of which order comes next?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="680" height="70" as="geometry" />
        </mxCell>
        <mxCell id="leftPanelBody" value="POSITION &amp; GEOGRAPHY&#xa;&#8226; Region (H3 hexagonal cell of current location)&#xa;&#8226; Distance to the driver's own home terminal&#xa;&#xa;HOURS OF SERVICE&#xa;&#8226; Remaining hours (binding limit across all 5 real clocks)&#xa;&#8226; Remaining 7-day cycle hours, tracked separately&#xa;&#8226; Remaining 14-day cycle hours, tracked separately&#xa;&#xa;TIME&#xa;&#8226; Hour of day  &#8226;  Day of week&#xa;&#xa;TRUCK CONDITION&#xa;&#8226; % of maintenance interval used (distance-based)&#xa;&#8226; % of maintenance interval used (calendar-based)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=15;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="680" height="410" as="geometry" />
        </mxCell>

        <mxCell id="rightPanelHdr" value="Q(s,a) -- Candidate-Specific Features&#xa;&quot;Given THIS driver, THIS truck, and THIS order -- how good a match is it?&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="680" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rightPanelBody" value="THIS DECISION'S ECONOMICS&#xa;&#8226; Pre-pickup deadhead miles &amp; hours&#xa;&#8226; Order weight, pallets, load type&#xa;&#8226; Load fill ratio (weight vs. pallet-space, whichever binds)&#xa;&#8226; FTL vs. LTL service type&#xa;&#xa;TIMING &amp; LEGALITY&#xa;&#8226; Planned driving hours / planned duty hours&#xa;&#8226; Real routed ETA vs. promised pickup time&#xa;&#xa;DESTINATION CONTEXT&#xa;&#8226; Distance from the delivery point to the nearest hub&#xa;&#8226; Local order density near the delivery point&#xa;&#xa;FLEET CONTEXT&#xa;&#8226; This specific truck's breakdown risk&#xa;&#8226; Total distance this decision commits the driver to&#xa;&#8226; Size of this driver's available truck pool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5fff5;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=15;spacingTop=15;" vertex="1" parent="1">
          <mxGeometry x="760" y="160" width="680" height="410" as="geometry" />
        </mxCell>

        <mxCell id="connectNote" value="Together: score(candidate) = reward(THIS decision's features, right panel) + &#947; &#215; V(the position this decision leaves you in, left panel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1400" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

