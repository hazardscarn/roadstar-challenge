          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="le8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="geofenceEvt" target="detention">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="le9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="detention" target="tripLog">
          <mxGeometry relative="1" as="geometry" />
