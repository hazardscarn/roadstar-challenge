          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="le4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rewardShared" target="quoteRec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="le5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="quoteRec" target="tripCreate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="le6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tripCreate" target="geofence">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
