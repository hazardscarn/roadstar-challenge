        <mxCell id="r5c0" value="Total deadhead miles" style="text;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Trebuchet MS;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="272" width="310" height="30" as="geometry" /></mxCell>
