        <mxCell id="r5c2" value="45,390" style="text;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Trebuchet MS;align=center;fontStyle=1;fontColor=#2d5a2d;" vertex="1" parent="1"><mxGeometry x="590" y="272" width="220" height="30" as="geometry" /></mxCell>
        <mxCell id="r5c3" value="49,957" style="text;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Trebuchet MS;align=center;fontStyle=1;fontColor=#2d5a2d;" vertex="1" parent="1"><mxGeometry x="810" y="272" width="260" height="30" as="geometry" /></mxCell>

        <mxCell id="r6c0" value="Avg net revenue / day (CAD)" style="text;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Trebuchet MS;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="302" width="310" height="30" as="geometry" /></mxCell>
